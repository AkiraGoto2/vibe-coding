# ══════════════════════════════════════════════════════════
#  Break Reminder — Environment Variables
#  Copy this file: cp .env.example .env
#  Then fill in your values below.
#  NEVER commit .env to git (it's in .gitignore).
# ══════════════════════════════════════════════════════════

# ── Database (Neon PostgreSQL) ─────────────────────────────
#
# HOW TO GET THESE:
# 1. Go to https://neon.tech and sign up (free)
# 2. Create a new project
# 3. In your project dashboard, click "Connection Details"
# 4. Select "Prisma" from the dropdown
# 5. Copy both connection strings shown below
#
# DATABASE_URL  → use the "Pooled connection" (has "?pgbouncer=true" at the end)
# DIRECT_URL    → use the "Direct connection" (no pgbouncer, used for migrations)
#
# Example format:
#   postgresql://USER:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Auth ───────────────────────────────────────────────────
# A random secret used to sign JWT tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. CHANGE THIS before deploying.
JWT_SECRET="change-this-to-a-random-32-character-secret"

# ── Email Verification (Resend) ────────────────────────────
# Required for sending OTP codes when users register.
# Sign up free at https://resend.com (3000 emails/month free)
# Steps:
#   1. Sign up → Dashboard → API Keys → Create API Key
#   2. Add and verify your domain (or use onboarding@resend.dev for testing)
#   3. Paste the key below
#
# WITHOUT THIS KEY: OTP codes are printed to the server console instead of emailed.
# This is fine for local development — check your terminal for the code.
RESEND_API_KEY="re_your_key_here"

# The "From" email address (must match your verified Resend domain)
EMAIL_FROM="noreply@yourdomain.com"

# ── Rate Limiting (Upstash Redis) — OPTIONAL ───────────────
# Protects login/register from brute force attacks.
# Without this, rate limiting is silently disabled (still safe for development).
# Free tier at https://upstash.com → Create Redis database → REST API tab
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── CORS — OPTIONAL ────────────────────────────────────────
# Leave empty to allow all origins (fine for Vercel + same-origin apps).
# In production with a custom domain, set this to your domain:
# ALLOWED_ORIGINS="https://myapp.vercel.app,https://myapp.com"
ALLOWED_ORIGINS=""

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL="info"
