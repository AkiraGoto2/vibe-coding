# ── Database (Neon PostgreSQL) ─────────────────────────────
#
# HOW TO GET THESE:
# 1. Go to https://neon.tech and sign up (free)
# 2. Create a new project
# 3. In your project dashboard, click "Connection Details"
# 4. Select "Prisma" from the dropdown
# 5. Copy both connection strings shown below
#
# DATABASE_URL  → use the "Pooled connection" (has "?pgbouncer=true" at the end)
# DIRECT_URL    → use the "Direct connection" (no pgbouncer, used for migrations)
#
# Example format:
#   postgresql://USER:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL="postgresql://neondb_owner:npg_X2UR3ycVYpwh@ep-old-violet-anz2jz7t.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:npg_X2UR3ycVYpwh@ep-old-violet-anz2jz7t.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="HgIBMlotiMFJIRNmfiynhIRYNcfkvSlpL"
RESEND_API_KEY="re_H9S1CpRM_6fKzRssu15C7g5o6JeXoExMo"
EMAIL_FROM="onboarding@resend.dev"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
