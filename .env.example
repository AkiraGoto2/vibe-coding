# Database (SQLite - автоматически создаётся в папке prisma/)
DATABASE_URL="file:./prisma/dev.db"

# JWT секрет — замените на случайную строку длиной 32+ символов
# Генерация: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Настройки SMTP для формы обратной связи (опционально)
# Если не указать — письма будут только в базе данных
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
FEEDBACK_TO="admin@yourapp.com"

# ExerciseDB API (RapidAPI)
# Получите ключ на: https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
EXERCISEDB_API_KEY="your-rapidapi-key-here"
